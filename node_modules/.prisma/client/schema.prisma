// This file IS the database design — Prisma reads this and generates
// the actual PostgreSQL tables via "npx prisma migrate dev".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  TEAMLEAD
  EMPLOYEE
  HR
  ACCOUNTANT
}

enum AttendanceSource {
  MOBILE
  DEVICE
}

model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  employees Employee[]
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Employee {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  passwordHash      String
  role              Role               @default(EMPLOYEE)
  department        Department?        @relation(fields: [departmentId], references: [id])
  departmentId      String?
  dob               DateTime?
  joiningDate       DateTime?
  motherName        String?
  fatherName        String?
  bloodGroup        String?
  photoUrl          String?
  createdAt         DateTime           @default(now())
  attendanceRecords AttendanceRecord[]

  manager   Employee?  @relation("ManagerReports", fields: [managerId], references: [id])
  managerId String?
  reports   Employee[] @relation("ManagerReports")

  leaveRequests LeaveRequest[] @relation("LeaveApplicant")
  approvals     LeaveRequest[] @relation("LeaveApprover")

  notifications   Notification[]
  travelRequests  TravelRequest[] @relation("TravelApplicant")
  travelApprovals TravelRequest[] @relation("TravelApprover")
  salarySlips     SalarySlip[]
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employee   Employee    @relation("LeaveApplicant", fields: [employeeId], references: [id])
  employeeId String
  approver   Employee?   @relation("LeaveApprover", fields: [approverId], references: [id])
  approverId String?
  fromDate   DateTime
  toDate     DateTime
  reason     String
  status     LeaveStatus @default(PENDING)
  reviewNote String?
  createdAt  DateTime    @default(now())
  reviewedAt DateTime?

  @@index([employeeId, status])
  @@index([approverId, status])
}

model Device {
  id         String             @id @default(uuid())
  name       String // e.g. "Main Office - Front Desk"
  location   String?
  apiKey     String             @unique // used to authenticate the device's requests
  lastSeenAt DateTime?
  attendance AttendanceRecord[]
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  employee   Employee         @relation(fields: [employeeId], references: [id])
  employeeId String
  checkInAt  DateTime         @default(now())
  checkOutAt DateTime?
  source     AttendanceSource // MOBILE (phone biometric) or DEVICE (office scanner)
  device     Device?          @relation(fields: [deviceId], references: [id])
  deviceId   String?
  latitude   Float? // optional, only relevant for MOBILE source
  longitude  Float?

  @@index([employeeId, checkInAt])
}

model Notification {
  id         String   @id @default(uuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  title      String
  message    String
  type       String // 'LEAVE_REQUEST' | 'LEAVE_APPROVED' | 'LEAVE_REJECTED'
  relatedId  String? // e.g. the LeaveRequest id, so tapping it can navigate there
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([employeeId, isRead])
}

enum TravelStatus {
  PENDING
  APPROVED
  REJECTED
}

model TravelRequest {
  id              String       @id @default(uuid())
  employee        Employee     @relation("TravelApplicant", fields: [employeeId], references: [id])
  employeeId      String
  approver        Employee?    @relation("TravelApprover", fields: [approverId], references: [id])
  approverId      String?
  destination     String
  purpose         String
  fromDate        DateTime
  toDate          DateTime
  estimatedAmount Float
  status          TravelStatus @default(PENDING)
  reviewNote      String?
  createdAt       DateTime     @default(now())
  reviewedAt      DateTime?

  @@index([employeeId, status])
  @@index([approverId, status])
}

model Holiday {
  id          String   @id @default(uuid())
  name        String
  date        DateTime
  description String?
  isMandatory Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model SalarySlip {
  id          String   @id @default(uuid())
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  String
  month       Int // 1-12
  year        Int
  basic       Float
  allowances  Float    @default(0)
  deductions  Float    @default(0)
  netPay      Float
  fileUrl     String?
  generatedAt DateTime @default(now())

  @@unique([employeeId, month, year])
}
